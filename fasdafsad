  // NEW: lightweight live-update during streaming, avoids full re-render per token
  function streamUpdate(idx, text) {
    var node = msgBox.querySelector('[data-msg-idx="' + idx + '"] .cg-msg-body');
    if (!node) { renderMessages(); node = msgBox.querySelector('[data-msg-idx="' + idx + '"] .cg-msg-body'); }
