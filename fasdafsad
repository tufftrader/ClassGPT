  // NEW: typewriter reveal — decouples what's shown from how the network actually delivers
  // chunks. Some proxies/CDNs buffer the whole SSE body before handing it to the browser,
  // so relying on raw chunk timing alone can make "streaming" look like it arrives all at
  // once. This reveals text at a steady pace regardless, with a catch-up curve so long
  // replies don't crawl if a big chunk (or the whole response) lands at once.
  function makeTypewriter(idx) {
    var queue = '';
    var shown = '';
    var timer = null;
    function tick() {
      if (shown.length >= queue.length) return;
      var remaining = queue.length - shown.length;
      var take = Math.max(2, Math.ceil(remaining / 25)); // reveal faster when far behind
      shown = queue.slice(0, shown.length + take);
      streamUpdate(idx, shown);
    }
    return {
      push: function (fullText) {
        queue = fullText;
        if (!timer) timer = setInterval(tick, 20);
      },
      finish: function () {
        return new Promise(function (resolve) {
          function drain() {
            tick();
            if (shown.length >= queue.length) {
              if (timer) { clearInterval(timer); timer = null; }
              resolve(shown);
            } else {
              requestAnimationFrame(drain);
            }
          }
          if (!timer) timer = setInterval(tick, 20);
          drain();
        });
      }
    };
  }

  // one-shot call (kept for cost estimation logic / fallback if streaming toggle is off)
  async function callModel(outgoingMsgs) {
    var res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + apiKey, 'HTTP-Referer': location.href, 'X-Title': 'ClassGPT' },
      body: JSON.stringify({ model: activeModel(), messages: outgoingMsgs })
    });
    return res.json();
  }

  // NEW: streaming call. onChunk receives the full accumulated text so far.
  async function callModelStream(outgoingMsgs, onChunk) {
    var res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + apiKey, 'HTTP-Referer': location.href, 'X-Title': 'ClassGPT' },
      body: JSON.stringify({ model: activeModel(), messages: outgoingMsgs, stream: true })
    });
    if (!res.ok || !res.body) {
      var errBody = null;
      try { errBody = await res.json(); } catch (e) {}
      throw new Error((errBody && errBody.error && errBody.error.message) || ('HTTP ' + res.status));
    }
    var reader = res.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    var fullText = '';
    while (true) {
      var chunk = await reader.read();
      if (chunk.done) break;
      buffer += decoder.decode(chunk.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop();
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (!line || line.indexOf('data:') !== 0) continue;
        var payload = line.slice(5).trim();
        if (payload === '[DONE]') continue;
        try {
          var json = JSON.parse(payload);
          var delta = json.choices && json.choices[0] && json.choices[0].delta && json.choices[0].delta.content;
          if (delta) { fullText += delta; onChunk(fullText); }
        } catch (e) { /* partial JSON line, wait for more */ }
      }
    }
    return fullText;
  }

  function estimateCost() {
    var preset = MODEL_PRESETS.find(function (p) { return p.id === settings.model; });
    if (!preset || preset.price == null) { costBar.style.display = 'none'; return; }
    var totalChars = currentThreadMessages().reduce(function (a, m) { return a + textOf(m.content).length; }, 0);
    var tokens = Math.round(totalChars / 4);
    var cost = (tokens / 1000000) * preset.price;
    costBar.style.display = 'block';
    costBar.textContent = '~' + tokens + ' tokens this thread · ~$' + cost.toFixed(4) + ' est.';
  }

  async function regenerate(idx) {
    var msgs = currentThreadMessages();
    var upTo = msgs.slice(0, idx);
    var outgoing = [{ role: 'system', content: systemPrompt }].concat(upTo.map(function (m) { return { role: m.role, content: m.content }; }));
    msgs[idx].content = '';
    msgs[idx].streaming = true;
    renderMessages();
    try {
      if (settings.streaming) {
        var typer = makeTypewriter(idx);
        var final = await callModelStream(outgoing, function (partial) { typer.push(partial); });
        var revealed = await typer.finish();
        msgs[idx].content = final || revealed || 'No response.';
      } else {
        var data = await callModel(outgoing);
        if (data.error) { msgs[idx].content = 'Error: ' + data.error.message; }
        else { msgs[idx].content = (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || 'No response.'; }
      }
    } catch (e) {
      msgs[idx].content = 'Error: ' + e.message;
    }
    msgs[idx].streaming = false;
    saveThreadsStore();
    renderMessages();
    if (settings.showCost) estimateCost();
  }

  function extractPageText() {
    var sel = window.getSelection().toString().trim();
    if (sel) return { text: sel, label: 'selection (' + sel.length + ' chars)' };
    var clone = document.body.cloneNode(true);
    var kill = clone.querySelectorAll('#classgpt-widget,script,style,noscript,svg,iframe');
    kill.forEach(function (el) { el.remove(); });
    var text = clone.innerText || clone.textContent || '';
    text = text.replace(/\n{3,}/g, '\n\n').replace(/[ \t]{2,}/g, ' ').trim();
    var MAXLEN = 12000;
    if (text.length > MAXLEN) text = text.slice(0, MAXLEN) + '\n\n[...page truncated...]';
    return { text: text, label: 'page (' + text.length + ' chars)' };
  }

  // ===== NEW: on-demand html2canvas loader for page screenshots =====
  var html2canvasLoading = null;
  function loadHtml2Canvas() {
    if (window.html2canvas) return Promise.resolve(window.html2canvas);
    if (html2canvasLoading) return html2canvasLoading;
    html2canvasLoading = new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
      s.onload = function () { resolve(window.html2canvas); };
      s.onerror = function () { reject(new Error('failed to load html2canvas')); };
      document.head.appendChild(s);
    });
    return html2canvasLoading;
  }

  async function captureScreenshot() {
    var lib = await loadHtml2Canvas();
    var wasVisible = box.style.display !== 'none';
    if (wasVisible) box.style.display = 'none';
    await new Promise(function (r) { setTimeout(r, 60); }); // let the hide paint before capture
    var canvas;
    try {
      canvas = await lib(document.body, { logging: false, useCORS: true, scale: 0.6 });
    } finally {
      if (wasVisible) box.style.display = 'flex';
    }
    return canvas.toDataURL('image/jpeg', 0.7);
  }

  var pageWatchObserver = null, pageWatchTimer = null, pageWatchDebounce = null;
  function refreshPageContextIfActive() {
    if (!pageContext) return;
    if (!contextBar || contextBar.style.display === 'none') return;
    var r = extractPageText();
    if (r.label.indexOf('selection') === 0) return;
    if (r.text && r.text !== pageContext) {
      pageContext = r.text;
      renderContextBar(r.label + ' · auto-updated');
    }
  }
  function startPageWatch() {
    stopPageWatch();
    pageWatchObserver = new MutationObserver(function () {
      clearTimeout(pageWatchDebounce);
      pageWatchDebounce = setTimeout(refreshPageContextIfActive, 1500);
    });
    pageWatchObserver.observe(document.body, { childList: true, subtree: true, characterData: true });
    pageWatchTimer = setInterval(refreshPageContextIfActive, 8000);
  }
  function stopPageWatch() {
    if (pageWatchObserver) { pageWatchObserver.disconnect(); pageWatchObserver = null; }
    if (pageWatchTimer) { clearInterval(pageWatchTimer); pageWatchTimer = null; }
    clearTimeout(pageWatchDebounce);
  }

  function renderContextBar(labelText) {
