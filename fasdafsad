  async function send() {
    var input = document.getElementById('cg-input');
    var text = input.value.trim();
    if (!text && !pendingImage) return;
    input.value = '';

    var userContent;
    if (pendingImage) {
      userContent = [{ type: 'text', text: text || 'What is in this image?' }, { type: 'image_url', image_url: { url: pendingImage } }];
    } else {
      userContent = text;
    }
    var msgs = currentThreadMessages();
    msgs.push({ role: 'user', content: userContent, pinned: false });
    pendingImage = null; imagePreview.style.display = 'none';
    saveThreadsStore();
    renderMessages();
    if (settings.showCost) estimateCost();

    var outgoing = [{ role: 'system', content: systemPrompt }];
    if (pageContext) outgoing.push({ role: 'system', content: 'Content of the current webpage (title: ' + document.title + ', url: ' + location.href + '):\n\n' + pageContext });
    if (pageScreenshot) {
      // NEW: give the model the screenshot as visual context (needs a vision-capable model)
      outgoing.push({ role: 'user', content: [{ type: 'text', text: '(This is a screenshot of the current page, for visual context alongside the extracted text above.)' }, { type: 'image_url', image_url: { url: pageScreenshot } }] });
    }
    outgoing = outgoing.concat(msgs.map(function (m) { return { role: m.role, content: m.content }; }));

    msgs.push({ role: 'assistant', content: '', pinned: false, streaming: true });
    renderMessages();
    var thinkingIdx = msgs.length - 1;

    try {
      if (settings.streaming) {
        var typer = makeTypewriter(thinkingIdx);
        var final = await callModelStream(outgoing, function (partial) { typer.push(partial); });
        var revealed = await typer.finish();
        msgs[thinkingIdx].content = final || revealed || 'No response.';
      } else {
        var data = await callModel(outgoing);
        if (data.error) { msgs[thinkingIdx].content = 'Error: ' + data.error.message; }
        else { msgs[thinkingIdx].content = (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || 'No response.'; }
      }
    } catch (e) {
      msgs[thinkingIdx].content = 'Error: ' + e.message;
    }
    msgs[thinkingIdx].streaming = false;
    saveThreadsStore();
    renderMessages();
    if (settings.showCost) estimateCost();
  }
  document.getElementById('cg-send').onclick = send;
  cgInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') send(); });

