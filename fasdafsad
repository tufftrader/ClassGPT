<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ClassGPT — a chat widget for any tab</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2064%2064%22%3E%0A%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%230f1015%22/%3E%0A%3Cpath%20d%3D%22M32%2014c-11%200-19%207.6-19%2017%200%205%202.4%209.4%206.4%2012.5-.4%202.6-1.6%205-3.6%206.9-.5.5-.1%201.4.6%201.3%204-.5%207.6-2.1%2010.4-4.5%201.6.4%203.4.6%205.2.6%2011%200%2019-7.6%2019-17s-8-17-19-17z%22%20fill%3D%22%237c9eff%22/%3E%0A%3Ccircle%20cx%3D%2225%22%20cy%3D%2231%22%20r%3D%222.6%22%20fill%3D%22%230f1015%22/%3E%0A%3Ccircle%20cx%3D%2232%22%20cy%3D%2231%22%20r%3D%222.6%22%20fill%3D%22%230f1015%22/%3E%0A%3Ccircle%20cx%3D%2239%22%20cy%3D%2231%22%20r%3D%222.6%22%20fill%3D%22%230f1015%22/%3E%0A%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0f1015;--panel:#14151a;--panel-2:#191a21;--border:#25262f;
    --text:#e9e9ef;--muted:#8a8b96;--accent:#7c9eff;--accent-dim:#4a5ba8;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;}
  body{min-height:100vh;display:flex;justify-content:center;padding:64px 20px 100px;}
  .wrap{max-width:640px;width:100%;}
  .eyebrow{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:14px;}
  h1{font-family:'Space Grotesk',sans-serif;font-size:44px;line-height:1.05;margin:0 0 16px;letter-spacing:-0.5px;}
  h1 span{color:var(--accent);}
  p.lede{color:var(--muted);font-size:16px;line-height:1.6;max-width:520px;margin:0 0 40px;}
  .bookmark-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:8px;}
  .bookmarklet-btn{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;color:#0f1015;background:var(--accent);padding:14px 22px;border-radius:10px;text-decoration:none;cursor:grab;display:inline-flex;align-items:center;gap:8px;box-shadow:0 8px 24px rgba(124,158,255,.25);user-select:none;}
  .bookmarklet-btn:active{cursor:grabbing;}
  .drag-hint{color:var(--muted);font-size:13px;font-family:'JetBrains Mono',monospace;}
  .steps{margin:48px 0;padding:0;list-style:none;counter-reset:step;border-top:1px solid var(--border);}
  .steps li{counter-increment:step;padding:20px 0;border-bottom:1px solid var(--border);display:flex;gap:18px;align-items:flex-start;}
  .steps li::before{content:counter(step);font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--accent);border:1px solid var(--accent-dim);width:26px;height:26px;min-width:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:2px;}
  .steps h3{font-family:'Space Grotesk',sans-serif;font-size:16px;margin:0 0 4px;font-weight:700;}
  .steps p{margin:0;color:var(--muted);font-size:14px;line-height:1.55;}
  .steps a{color:var(--accent);}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:24px;margin-top:8px;}
  .panel h2{font-family:'Space Grotesk',sans-serif;font-size:18px;margin:0 0 10px;}
  .panel p{color:var(--muted);font-size:14px;line-height:1.6;margin:0 0 16px;}
  .try-btn{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:500;color:var(--text);background:var(--panel-2);border:1px solid var(--border);padding:10px 16px;border-radius:8px;cursor:pointer;}
  .try-btn:hover{border-color:var(--accent-dim);}
  .fallback{margin-top:14px;font-size:12.5px;color:var(--muted);line-height:1.6;}
  .fallback code{display:block;background:#0a0b0f;border:1px solid var(--border);border-radius:8px;padding:12px;margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:11px;color:#a8b6ff;word-break:break-all;max-height:120px;overflow-y:auto;}
  .note{margin-top:40px;font-size:13px;color:var(--muted);border-left:2px solid var(--accent-dim);padding-left:14px;line-height:1.6;}
  .note.warn{border-left-color:#e2a33d;}
  .scratch{margin-top:24px;}
  .scratch textarea{width:100%;min-height:70px;background:#0a0b0f;border:1px solid var(--border);border-radius:8px;color:var(--text);padding:10px;font-family:'Inter',sans-serif;font-size:13px;resize:vertical;}
  .scratch label{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);display:block;margin-bottom:6px;}
  .key-panel{background:var(--panel);border:1px solid var(--accent-dim);border-radius:12px;padding:24px;margin:32px 0;}
  .key-panel h2{font-family:'Space Grotesk',sans-serif;font-size:18px;margin:0 0 8px;}
  .key-panel p{color:var(--muted);font-size:13.5px;line-height:1.6;margin:0 0 16px;}
  .key-row{display:flex;gap:8px;flex-wrap:wrap;}
  .key-row input{flex:1;min-width:220px;padding:10px 12px;border-radius:8px;border:1px solid var(--border);background:#0a0b0f;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:12.5px;}
  .key-row button{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:14px;color:#0f1015;background:var(--accent);border:none;padding:10px 18px;border-radius:8px;cursor:pointer;}
  .key-status{margin-top:12px;font-size:12.5px;font-family:'JetBrains Mono',monospace;color:var(--muted);}
  .key-status.ready{color:#7fd99a;}
  .feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;}
  .feature-grid div{background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;font-size:12px;color:var(--muted);}
  .feature-grid strong{color:var(--text);display:block;font-size:12.5px;margin-bottom:2px;}
  @media (max-width:480px){.feature-grid{grid-template-columns:1fr;}}
</style>
</head>
<body>
<div class="wrap">
  <div class="eyebrow">bookmarklet</div>
  <h1>Class<span>GPT</span></h1>
  <p class="lede">A chat window that drops into any webpage. Bake your OpenRouter key in below and the bookmark works on the current page — it can read the page or your text selection, take a screenshot when it loads a page, and adapts its tone a bit depending on what kind of site you're on.</p>

  <div class="key-panel">
    <h2>1. Bake in your key</h2>
    <p>Paste your OpenRouter key here. It's embedded straight into the bookmark link below on your device — nothing is sent anywhere else. Everyone builds their own personal bookmarklet from their own key; no key is shared or stored on this page. Get a free key at <a href="https://openrouter.ai/keys" target="_blank" rel="noopener" style="color:var(--accent);">openrouter.ai/keys</a>.</p>
    <div class="key-row">
      <input type="password" id="key-input" placeholder="sk-or-v1-...">
      <button id="key-build">Build my bookmarklet</button>
    </div>
    <div class="key-status" id="key-status">no key entered yet — the link below will ask for one on first use instead</div>
  </div>

  <div class="bookmark-row">
    <a class="bookmarklet-btn" id="main-bookmarklet" href="#" onclick="return false;">↳ ClassGPT</a>
    <span class="drag-hint">drag this to your bookmarks bar</span>
  </div>

  <ol class="steps">
    <li><div><h3>Paste your key above first</h3><p>Each person builds their own bookmarklet from their own key — the button above updates itself as soon as you click "Build my bookmarklet."</p></div></li>
    <li><div><h3>Show your bookmarks bar</h3><p>Ctrl/Cmd + Shift + B in Chrome, Edge, or Firefox, if it isn't already showing.</p></div></li>
    <li><div><h3>Drag the ClassGPT button up there</h3><p>It's a real link — drag it straight into the bookmarks bar. On phones, use the browser's "add bookmark" flow and paste the code from the box below instead.</p></div></li>
    <li><div><h3>Click it on any site</h3><p>It opens straight into the chat, ready to go, every time. Click the bookmark again (or Ctrl+Shift+G, if that's on) to show or hide it without losing your chat.</p></div></li>
    <li><div><h3>Explore the icons in the header</h3><p>📁 switches between saved threads, ⚙ opens settings (model, features), ✕ closes. Inside the message box, 📄 reads the page or your current selection (and grabs a screenshot too, unless you've turned that off), 🌐 translates whatever's selected, and 🎤 is voice input.</p></div></li>
  </ol>

  <div class="panel">
    <h2>What's in it</h2>
    <div class="feature-grid">
      <div><strong>Live streaming replies</strong>Responses type themselves in as they're generated instead of appearing all at once.</div>
      <div><strong>Site-aware tone</strong>Adjusts its tone a bit depending on the kind of site you're on — docs sites get technical, social sites get casual, and so on.</div>
      <div><strong>Page screenshot</strong>When you load page context, it also grabs a screenshot so the model can see layout/visuals a text extract would miss (needs a vision-capable model).</div>
      <div><strong>Multiple threads</strong>Keep separate conversations per topic and switch between them from the 📁 icon.</div>
      <div><strong>Pin messages</strong>Pin any message so it stays visible in a bar above the chat as it scrolls.</div>
      <div><strong>Regenerate</strong>Not happy with a reply? Regenerate it in place without retyping your question.</div>
      <div><strong>Read page or selection</strong>📄 reads your current text selection if you have one, otherwise the whole page.</div>
      <div><strong>Image input</strong>Paste or drag an image into the chat and ask about it (needs a vision-capable model).</div>
      <div><strong>Translate selection</strong>🌐 detects the language of whatever's selected and translates it to your browser's language.</div>
      <div><strong>Model picker</strong>Dropdown of presets or a custom model id. Defaults to GPT-4o mini.</div>
      <div><strong>Markdown, cost estimate, voice input, export, insert-into-page</strong>All toggleable from settings.</div>
    </div>
  </div>

  <div class="panel">
    <h2>Try it on this page first</h2>
    <p>Launch it, poke around the 📁 and ⚙ icons, select some text on this page and hit 📄 or 🌐, or drop an image into the chat.</p>
    <button class="try-btn" id="try-it">▸ launch preview</button>
    <div class="scratch">
      <label>scratchpad — click here before hitting insert</label>
      <textarea placeholder="Click here, then use 'insert into page' on a ClassGPT reply..."></textarea>
    </div>
    <div class="fallback">
      Drag-and-drop not working (some mobile browsers strip it)? Copy this into a new bookmark's URL field manually — build your keyed version above first, then copy from here:
      <code id="raw-code">building...</code>
    </div>
  </div>

  <p class="note">A key baked into the bookmark link is stored in plain text inside your browser's bookmarks — fine on a personal device, but don't share the link or sync it somewhere untrusted. It's sent straight from your browser to OpenRouter and never passes through us. Each visitor bakes in their own key locally; this page doesn't collect or see anyone's key.</p>
  <p class="note warn">Reading a page/selection, translating, and inserting text are there to help you understand material and move your own words faster — not to auto-answer graded quizzes or assignments. It's built and prompted with that boundary in mind, and it only acts when you click the button for it.</p>
</div>

<script>
var WIDGET_B64 = "";
function decodeTemplate(){return decodeURIComponent(escape(atob(WIDGET_B64)));}
function buildBookmarklet(key){
  var tmpl = decodeTemplate();
  var literal = key ? JSON.stringify(key) : 'null';
  var withKey = tmpl.replace('__API_KEY_LITERAL__', literal);
  return 'javascript:' + encodeURIComponent(withKey);
}
var keyInput = document.getElementById('key-input');
var buildBtn = document.getElementById('key-build');
var status = document.getElementById('key-status');
var mainLink = document.getElementById('main-bookmarklet');
var rawCode = document.getElementById('raw-code');
mainLink.href = buildBookmarklet('');
rawCode.textContent = mainLink.href;
buildBtn.addEventListener('click', function(){
  var key = keyInput.value.trim();
  if(!key){status.textContent = 'paste a key first';status.className = 'key-status';return;}
  var link = buildBookmarklet(key);
  mainLink.href = link;
  rawCode.textContent = link;
  status.textContent = '✓ key baked in — drag the button below now';
  status.className = 'key-status ready';
});
document.getElementById('try-it').addEventListener('click', function(){
(function () {
  var EXISTING = document.getElementById('classgpt-widget');
  if (EXISTING) {
    EXISTING.style.display = EXISTING.style.display === 'none' ? 'flex' : 'none';
    return;
  }

  var SETTINGS_KEY = 'classgpt_settings';
  var THREADS_PREFIX = 'classgpt_threads_';
  var POSITION_KEY = 'classgpt_position';
  var BAKED_KEY='__API_KEY__';

  var MODEL_PRESETS = [
    { id: 'openai/gpt-4o-mini', label: 'GPT-4o mini (default)', price: 0.15 },
    { id: 'openai/gpt-4o', label: 'GPT-4o', price: 2.5 },
    { id: 'anthropic/claude-3.5-haiku', label: 'Claude 3.5 Haiku', price: 0.8 },
    { id: 'anthropic/claude-3.5-sonnet', label: 'Claude 3.5 Sonnet', price: 3 },
    { id: 'google/gemini-2.0-flash-001', label: 'Gemini 2.0 Flash', price: 0.1 },
    { id: 'custom', label: 'Custom model id...', price: null }
  ];

  var DEFAULT_SETTINGS = {
    model: 'openai/gpt-4o-mini',
    customModel: '',
    markdown: true,
    rememberHistory: false,
    rememberPosition: false,
    showCost: true,
    allowInsert: true,
    compact: false,
    voiceInput: true,
    keyboardShortcut: true,
    streaming: true,        // NEW: toggle for streaming vs one-shot
    pageScreenshot: true    // NEW: toggle for auto-screenshot on page load
  };

  function loadSettings() {
    try {
      var raw = localStorage.getItem(SETTINGS_KEY);
      if (!raw) return Object.assign({}, DEFAULT_SETTINGS);
      return Object.assign({}, DEFAULT_SETTINGS, JSON.parse(raw));
    } catch (e) { return Object.assign({}, DEFAULT_SETTINGS); }
  }
  function saveSettings(s) { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)); }

  var settings = loadSettings();
  var apiKey = (BAKED_KEY && BAKED_KEY.indexOf('API_KEY') === -1) ? BAKED_KEY : localStorage.getItem('classgpt_api_key');
  if (!apiKey) {
    apiKey = prompt('Paste your OpenRouter API key (get one free at openrouter.ai/keys):');
    if (!apiKey) return;
    localStorage.setItem('classgpt_api_key', apiKey);
  } else if (!localStorage.getItem('classgpt_api_key')) {
    localStorage.setItem('classgpt_api_key', apiKey);
  }

  function activeModel() {
    return settings.model === 'custom' ? (settings.customModel || 'openai/gpt-4o-mini') : settings.model;
  }

  var pageContext = null;
  var pageScreenshot = null; // NEW: dataURL of captured page screenshot
  var compact = settings.compact;
  var pendingImage = null;

  var hostname = location.hostname || 'page';
  var threadsKey = THREADS_PREFIX + hostname;

  function loadThreadsStore() {
    if (!settings.rememberHistory) return { threads: { 'Default': [] }, active: 'Default' };
    try {
      var raw = localStorage.getItem(threadsKey);
      if (!raw) return { threads: { 'Default': [] }, active: 'Default' };
      var parsed = JSON.parse(raw);
      if (!parsed.threads || !Object.keys(parsed.threads).length) return { threads: { 'Default': [] }, active: 'Default' };
      if (!parsed.threads[parsed.active]) parsed.active = Object.keys(parsed.threads)[0];
      return parsed;
    } catch (e) { return { threads: { 'Default': [] }, active: 'Default' }; }
  }
  function saveThreadsStore() {
    if (!settings.rememberHistory) return;
    localStorage.setItem(threadsKey, JSON.stringify(threadsStore));
  }

  var threadsStore = loadThreadsStore();
  function currentThreadMessages() { return threadsStore.threads[threadsStore.active]; }

  // ===== NEW: site-aware tone =====
  var SITE_PROFILES = [
    { match: /github\.com|gitlab\.com|stackoverflow\.com|(^|\.)docs\.|readthedocs\.io|developer\.mozilla\.org/, tone: 'This site looks like developer documentation or code hosting. Be precise and technical, reference exact function/API/file names from the page when relevant, and prefer code snippets over prose.' },
    { match: /reddit\.com|twitter\.com|x\.com|news\.ycombinator\.com|discord\.com/, tone: 'This site looks like a social or discussion platform. Keep responses casual, conversational, and to the point.' },
    { match: /wikipedia\.org|britannica\.com/, tone: 'This site looks like a reference or encyclopedia source. Prioritize accuracy and stick closely to what the page context actually says.' },
    { match: /\.edu$|coursera\.org|khanacademy\.org|edx\.org/, tone: 'This site looks educational. Focus on helping the user build understanding step by step rather than just stating conclusions.' },
    { match: /amazon\.|ebay\.|etsy\.com|shopify\./, tone: 'This site looks like a shopping page. Help the user evaluate the product (price, specs, reviews on the page) rather than general chit-chat.' }
  ];
  function siteToneAddendum() {
    for (var i = 0; i < SITE_PROFILES.length; i++) {
      if (SITE_PROFILES[i].match.test(hostname)) return SITE_PROFILES[i].tone;
    }
    return '';
  }

  var baseSystemPrompt = 'You are ClassGPT, a concise, helpful assistant embedded as a floating widget on a webpage. When the user has shared page or selected text with you, use it to answer questions, explain things, summarize, or translate — but never just produce finished answers to graded assignments, quizzes, or homework problems on their behalf; instead help them understand the material. The user may draft messages (replies, notes, snippets) that they write themselves into a text field on the page using an insert button you provide — that is their own composed text, not you answering questions for them. If a screenshot of the page is provided, use it as additional visual context alongside the extracted text.';
  var siteAddendum = siteToneAddendum();
  var systemPrompt = siteAddendum ? (baseSystemPrompt + '\n\n' + siteAddendum) : baseSystemPrompt;

  var box = document.createElement('div');
  box.id = 'classgpt-widget';
  function boxSize() { return compact ? { w: 280, h: 400 } : { w: 340, h: 540 }; }
  function applySize() { var sz = boxSize(); box.style.width = sz.w + 'px'; box.style.height = sz.h + 'px'; }
  box.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#14151a;color:#e9e9ef;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.5);z-index:2147483647;display:flex;flex-direction:column;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;overflow:hidden;border:1px solid #2a2b33;';
  applySize();

  if (settings.rememberPosition) {
    try {
      var pos = JSON.parse(localStorage.getItem(POSITION_KEY) || 'null');
      if (pos && pos.left && pos.top) { box.style.left = pos.left; box.style.top = pos.top; box.style.right = 'auto'; box.style.bottom = 'auto'; }
    } catch (e) {}
  }

  box.innerHTML =
    '<div id="cg-header" style="padding:10px 12px;background:#1c1d24;cursor:move;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #2a2b33;flex-shrink:0;">' +
      '<span style="font-weight:700;letter-spacing:.2px;font-size:14px;">Class<span style="color:#7c9eff;">GPT</span></span>' +
      '<span style="display:flex;gap:9px;align-items:center;">' +
        '<span id="cg-threads-btn" title="Threads" style="cursor:pointer;opacity:.7;font-size:13px;">&#128194;</span>' +
        '<span id="cg-settings-btn" title="Settings" style="cursor:pointer;opacity:.7;font-size:14px;">&#9881;</span>' +
        '<span id="cg-close" title="Close" style="cursor:pointer;opacity:.7;font-size:15px;">&#10005;</span>' +
      '</span>' +
    '</div>' +
    '<div id="cg-view-chat" style="display:flex;flex-direction:column;flex:1;min-height:0;">' +
      '<div id="cg-pinned-bar" style="display:none;flex-direction:column;gap:4px;padding:8px 12px;background:#1a1b22;border-bottom:1px solid #2a2b33;max-height:90px;overflow-y:auto;"></div>' +
      '<div id="cg-messages" style="flex:1;overflow-y:auto;padding:12px;font-size:13.5px;line-height:1.45;"></div>' +
      '<div id="cg-context-bar" style="display:none;padding:6px 12px;background:#1c1d24;border-top:1px solid #2a2b33;font-size:11.5px;color:#8a8b96;align-items:center;justify-content:space-between;"></div>' +
      '<div id="cg-image-preview" style="display:none;padding:6px 12px;background:#1c1d24;border-top:1px solid #2a2b33;align-items:center;gap:8px;"></div>' +
      '<div id="cg-cost-bar" style="display:none;padding:4px 12px;font-size:10.5px;color:#5f606a;font-family:monospace;"></div>' +
      '<div style="display:flex;gap:5px;padding:10px;border-top:1px solid #2a2b33;background:#17181f;flex-shrink:0;flex-wrap:wrap;">' +
        '<button id="cg-readpage" title="Highlighted text: ask about it instantly. Nothing selected: load the whole page (+ screenshot) as context." style="padding:8px 8px;border-radius:8px;border:1px solid #2a2b33;background:#0f1015;color:#e9e9ef;cursor:pointer;font-size:12px;">&#128196;</button>' +
        '<button id="cg-translate" title="Translate selected text" style="padding:8px 8px;border-radius:8px;border:1px solid #2a2b33;background:#0f1015;color:#e9e9ef;cursor:pointer;font-size:12px;">&#127760;</button>' +
        '<button id="cg-mic" title="Voice input" style="padding:8px 8px;border-radius:8px;border:1px solid #2a2b33;background:#0f1015;color:#e9e9ef;cursor:pointer;font-size:12px;">&#127908;</button>' +
        '<input id="cg-input" style="flex:1;padding:8px 10px;border-radius:8px;border:1px solid #2a2b33;background:#0f1015;color:#e9e9ef;outline:none;font-size:13px;min-width:80px;" placeholder="Ask, paste an image, or drop one...">' +
        '<button id="cg-send" style="padding:8px 12px;border-radius:8px;border:none;background:#7c9eff;color:#0f1015;font-weight:700;cursor:pointer;">Go</button>' +
      '</div>' +
    '</div>' +
    '<div id="cg-view-settings" style="display:none;flex-direction:column;flex:1;min-height:0;overflow-y:auto;padding:14px;font-size:12.5px;"></div>' +
    '<div id="cg-view-threads" style="display:none;flex-direction:column;flex:1;min-height:0;overflow-y:auto;padding:14px;font-size:12.5px;"></div>';

  document.body.appendChild(box);
  document.getElementById('cg-close').onclick = function () { stopPageWatch(); box.remove(); };

  // dragging
  var drag = false, ox = 0, oy = 0;
  var header = document.getElementById('cg-header');
  header.onmousedown = function (e) {
