    if (tag === 'TEXTAREA') return true;
    if (tag === 'INPUT') { var t = (el.getAttribute('type') || 'text').toLowerCase(); return ['text', 'search', 'email', 'url', 'tel'].indexOf(t) !== -1; }
    if (el.isContentEditable) return true;
