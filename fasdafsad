  var threadsView = document.getElementById('cg-view-threads');

  function fieldRow(labelText, inputEl) {
    var row = document.createElement('div'); row.style.cssText = 'margin-bottom:14px;';
    var label = document.createElement('div');
    label.textContent = labelText;
    label.style.cssText = 'font-size:11px;color:#8a8b96;margin-bottom:5px;text-transform:uppercase;letter-spacing:.3px;';
    row.appendChild(label); row.appendChild(inputEl);
    return row;
  }
  function toggleRow(labelText, key) {
    var row = document.createElement('label');
    row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid #22232b;cursor:pointer;font-size:12.5px;';
    var span = document.createElement('span'); span.textContent = labelText;
    var cb = document.createElement('input');
    cb.type = 'checkbox'; cb.checked = !!settings[key];
    cb.style.cssText = 'width:16px;height:16px;accent-color:#7c9eff;cursor:pointer;';
    cb.onchange = function () { settings[key] = cb.checked; saveSettings(settings); applySettingsSideEffects(); };
    row.appendChild(span); row.appendChild(cb);
    return row;
  }
  function applySettingsSideEffects() {
    compact = settings.compact; applySize();
    if (!settings.voiceInput || !SpeechRec) { micBtn.style.display = 'none'; } else { micBtn.style.display = 'inline-block'; }
    if (!settings.showCost) costBar.style.display = 'none';
    renderMessages();
  }

  function buildSettingsView() {
    settingsView.innerHTML = '';
    var backBtn = document.createElement('button');
    backBtn.textContent = '← back to chat';
    backBtn.style.cssText = 'background:none;border:none;color:#7c9eff;font-size:12.5px;cursor:pointer;padding:0 0 14px;text-align:left;';
    backBtn.onclick = function () { settingsView.style.display = 'none'; chatView.style.display = 'flex'; };
    settingsView.appendChild(backBtn);

    var keyInput = document.createElement('input');
    keyInput.type = 'password'; keyInput.value = apiKey || '';
    keyInput.style.cssText = 'width:100%;padding:8px;border-radius:6px;border:1px solid #2a2b33;background:#0a0b0f;color:#e9e9ef;font-family:monospace;font-size:11.5px;';
    keyInput.onchange = function () { apiKey = keyInput.value.trim(); localStorage.setItem('classgpt_api_key', apiKey); };
    settingsView.appendChild(fieldRow('OpenRouter API key', keyInput));

    var modelSelect = document.createElement('select');
    modelSelect.style.cssText = 'width:100%;padding:8px;border-radius:6px;border:1px solid #2a2b33;background:#0a0b0f;color:#e9e9ef;font-size:12.5px;';
    MODEL_PRESETS.forEach(function (p) {
      var opt = document.createElement('option'); opt.value = p.id; opt.textContent = p.label;
      if (p.id === settings.model) opt.selected = true;
      modelSelect.appendChild(opt);
    });
    var customWrap = document.createElement('div');
    customWrap.style.cssText = 'margin-top:8px;' + (settings.model === 'custom' ? '' : 'display:none;');
    var customInput = document.createElement('input');
    customInput.placeholder = 'provider/model-id'; customInput.value = settings.customModel || '';
    customInput.style.cssText = 'width:100%;padding:8px;border-radius:6px;border:1px solid #2a2b33;background:#0a0b0f;color:#e9e9ef;font-family:monospace;font-size:11.5px;';
    customInput.onchange = function () { settings.customModel = customInput.value.trim(); saveSettings(settings); };
    customWrap.appendChild(customInput);
    modelSelect.onchange = function () { settings.model = modelSelect.value; saveSettings(settings); customWrap.style.display = settings.model === 'custom' ? 'block' : 'none'; };
    var modelWrap = document.createElement('div'); modelWrap.appendChild(modelSelect); modelWrap.appendChild(customWrap);
    settingsView.appendChild(fieldRow('Model', modelWrap));

    var togglesHeader = document.createElement('div');
    togglesHeader.textContent = 'Features';
    togglesHeader.style.cssText = 'font-size:11px;color:#8a8b96;margin:16px 0 4px;text-transform:uppercase;letter-spacing:.3px;';
    settingsView.appendChild(togglesHeader);
    settingsView.appendChild(toggleRow('Stream responses live', 'streaming'));
    settingsView.appendChild(toggleRow('Screenshot page on load (📄)', 'pageScreenshot'));
    settingsView.appendChild(toggleRow('Markdown rendering', 'markdown'));
    settingsView.appendChild(toggleRow('Remember threads on this site', 'rememberHistory'));
    settingsView.appendChild(toggleRow('Remember widget position', 'rememberPosition'));
    settingsView.appendChild(toggleRow('Show token/cost estimate', 'showCost'));
    settingsView.appendChild(toggleRow('Allow "insert into page"', 'allowInsert'));
    settingsView.appendChild(toggleRow('Compact size', 'compact'));
    settingsView.appendChild(toggleRow('Voice input (mic button)', 'voiceInput'));
    settingsView.appendChild(toggleRow('Ctrl+Shift+G to show/hide', 'keyboardShortcut'));

    var siteNote = document.createElement('div');
    siteNote.textContent = siteAddendum ? ('Site tone active for ' + hostname + ': ' + siteAddendum) : ('No special tone profile matched for ' + hostname + ' — using default tone.');
    siteNote.style.cssText = 'margin-top:14px;font-size:11px;color:#5f606a;line-height:1.5;';
    settingsView.appendChild(siteNote);

    var exportBtn = document.createElement('button');
    exportBtn.textContent = 'Export this thread (.txt)';
    exportBtn.style.cssText = 'width:100%;margin-top:16px;padding:9px;border-radius:8px;border:1px solid #2a2b33;background:#191a21;color:#e9e9ef;cursor:pointer;font-size:12px;';
    exportBtn.onclick = function () {
      var lines = currentThreadMessages().map(function (m) { return (m.role === 'user' ? 'You: ' : 'ClassGPT: ') + textOf(m.content); });
      var blob = new Blob([lines.join('\n\n')], { type: 'text/plain' });
      var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'classgpt-' + threadsStore.active + '.txt'; a.click();
    };
    settingsView.appendChild(exportBtn);

    var clearBtn = document.createElement('button');
    clearBtn.textContent = 'Clear all ClassGPT data on this site';
    clearBtn.style.cssText = 'width:100%;margin-top:8px;padding:9px;border-radius:8px;border:1px solid #2a2b33;background:#191a21;color:#8a8b96;cursor:pointer;font-size:12px;';
    clearBtn.onclick = function () {
      localStorage.removeItem(threadsKey);
      threadsStore = { threads: { 'Default': [] }, active: 'Default' };
      renderMessages();
      clearBtn.textContent = 'cleared';
      setTimeout(function () { clearBtn.textContent = 'Clear all ClassGPT data on this site'; }, 1200);
    };
    settingsView.appendChild(clearBtn);
  }

  function buildThreadsView() {
    threadsView.innerHTML = '';
    var backBtn = document.createElement('button');
    backBtn.textContent = '← back to chat';
    backBtn.style.cssText = 'background:none;border:none;color:#7c9eff;font-size:12.5px;cursor:pointer;padding:0 0 14px;text-align:left;';
    backBtn.onclick = function () { threadsView.style.display = 'none'; chatView.style.display = 'flex'; };
    threadsView.appendChild(backBtn);

    if (!settings.rememberHistory) {
      var note = document.createElement('div');
      note.textContent = 'Turn on "Remember threads on this site" in settings to keep more than one thread and have them persist.';
      note.style.cssText = 'color:#8a8b96;font-size:12px;line-height:1.5;margin-bottom:12px;';
      threadsView.appendChild(note);
    }

    Object.keys(threadsStore.threads).forEach(function (name) {
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #22232b;';
      var label = document.createElement('span');
      label.textContent = (name === threadsStore.active ? '● ' : '○ ') + name;
      label.style.cssText = 'cursor:pointer;font-size:13px;' + (name === threadsStore.active ? 'color:#7c9eff;font-weight:700;' : 'color:#e9e9ef;');
      label.onclick = function () { threadsStore.active = name; saveThreadsStore(); renderMessages(); threadsView.style.display = 'none'; chatView.style.display = 'flex'; };
      row.appendChild(label);
      if (Object.keys(threadsStore.threads).length > 1) {
        var del = document.createElement('span');
        del.textContent = 'delete';
        del.style.cssText = 'font-size:11px;color:#8a8b96;cursor:pointer;';
        del.onclick = function () {
          delete threadsStore.threads[name];
          if (threadsStore.active === name) threadsStore.active = Object.keys(threadsStore.threads)[0];
          saveThreadsStore(); buildThreadsView(); renderMessages();
        };
        row.appendChild(del);
      }
      threadsView.appendChild(row);
    });

    var newBtn = document.createElement('button');
    newBtn.textContent = '+ New thread';
    newBtn.style.cssText = 'width:100%;margin-top:14px;padding:9px;border-radius:8px;border:1px solid #2a2b33;background:#191a21;color:#e9e9ef;cursor:pointer;font-size:12px;';
    newBtn.onclick = function () {
      var name = prompt('Name this thread:');
      if (!name) return;
      if (threadsStore.threads[name]) { alert('A thread with that name already exists.'); return; }
      threadsStore.threads[name] = [];
      threadsStore.active = name;
      saveThreadsStore(); buildThreadsView(); renderMessages();
    };
    threadsView.appendChild(newBtn);
  }

  document.getElementById('cg-settings-btn').onclick = function () { buildSettingsView(); chatView.style.display = 'none'; settingsView.style.display = 'flex'; };
  document.getElementById('cg-threads-btn').onclick = function () { buildThreadsView(); chatView.style.display = 'none'; threadsView.style.display = 'flex'; };

  applySettingsSideEffects();
  renderMessages();
  cgInput.focus();
})();

});
</script>
</body>
</html>
